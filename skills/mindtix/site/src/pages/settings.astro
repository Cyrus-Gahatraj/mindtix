---
import fs from "node:fs";
import Base from "../layouts/Base.astro";
import { BRAIN, brainFolders, folders, load, settings } from "../lib/brain.js";
import { engine, hasClaude, llm, MODELS } from "../lib/ask.js";

const D = load(), s = settings(), how = engine(), ai = llm(), claude = hasClaude();
const shownF = folders(), all = brainFolders();
const isOn = f => shownF === "all" || shownF.includes(f);
let astro = "";
try { astro = JSON.parse(fs.readFileSync("package.json", "utf8")).dependencies.astro } catch {}
---
<Base D={D} title="Settings" active="settings">
  <p class="eyebrow">Saved in this site's mindtix.json, and the brain's .env for API keys</p>
  <h1>Settings</h1>

  <div class="settings">
    <section class="setting" id="chat">
      <div><h2>Chat engine</h2><p class="help">What answers in Ask. Commands like /mindtix today need Claude Code.</p></div>
      <form class="body" id="engine-form">
        <label class="option"><input type="radio" name="engine" value="claude" checked={how.kind === "claude"}>
          <div><b>Claude Code {claude ? <span class="pill ok">found</span> : <span class="pill no">not installed</span>}</b>
          <span>Uses your Claude login. Reads and edits notes itself and runs the /mindtix commands, with the same safety hooks as the terminal.</span></div></label>
        <div class="sub" data-for="claude">
          <div class="lbl">Model</div>
          <div class="seg" role="group" aria-label="Claude Code model" id="model">
            {["", ...MODELS].map(m => <button type="button" data-model={m} aria-pressed={String((s.model || "") === m)}>{m ? m[0].toUpperCase() + m.slice(1) : "Default"}</button>)}
          </div>
          <label class="check"><input type="checkbox" id="edits" checked={s.edits !== false}><div>Let the chat edit notes<span>Needed for /mindtix recall, /mindtix capture and the rest. Off: it only reads.</span></div></label>
        </div>
        <label class="option"><input type="radio" name="engine" value="api" checked={how.kind === "api"}>
          <div><b>API {ai ? <span class="pill ok">set up</span> : <span class="pill">not set up</span>}</b>
          <span>Claude with an API key, or any OpenAI-compatible endpoint (OmniRoute, Ollama, OpenRouter). Answers questions from your notes; no commands.</span></div></label>
        <div class="sub" data-for="api">
          <div class="seg" role="group" aria-label="Provider" id="provider">
            <button type="button" data-kind="openai" aria-pressed={String(ai?.kind !== "claude")}>OpenAI-compatible</button>
            <button type="button" data-kind="claude" aria-pressed={String(ai?.kind === "claude")}>Claude API</button>
          </div>
          <input class="field" id="url" placeholder="Endpoint, like http://localhost:20128/v1" value={ai?.kind === "openai" ? ai.url : ""} spellcheck="false" aria-label="Endpoint URL">
          <input class="field" id="key" type="password" autocomplete="off" placeholder={ai ? "API key · leave empty to keep the saved one" : "API key (empty for a local Ollama)"} aria-label="API key">
          <input class="field" id="apimodel" placeholder="Model · empty for the default" value={ai && !["auto", "claude-opus-5-5"].includes(ai.model) ? ai.model : ""} spellcheck="false" aria-label="Model">
          <p class="help" style="margin:0">Saved in the brain's .env, which git ignores. Keys are never shown here again and only go to that AI.</p>
        </div>
        <div class="row"><button class="btn" type="submit">Save</button><span class="saved" id="engine-saved" aria-live="polite"></span></div>
      </form>
    </section>

    <section class="setting">
      <div><h2>Folders</h2><p class="help">Which parts of the brain the site shows and Ask reads. private/, logs/ and raw/imports/ never are.</p></div>
      <div class="body">
        <div class="chips" id="folders">{all.map(f => <button class="chip" type="button" data-f={f} aria-pressed={String(isOn(f))}>{f}</button>)}</div>
        <div class="row"><button class="btn ghost sm" type="button" id="save-folders">Save folders</button><span class="saved" id="folders-saved" aria-live="polite"></span></div>
      </div>
    </section>

    <section class="setting">
      <div><h2>Appearance</h2><p class="help">Kept in this browser.</p></div>
      <div class="body"><div class="seg" role="group" aria-label="Theme" id="theme">
        <button type="button" data-t="system">System</button><button type="button" data-t="light">Light</button><button type="button" data-t="dark">Dark</button>
      </div></div>
    </section>

    <section class="setting">
      <div><h2>Keyboard</h2></div>
      <div class="body keys">
        <span><kbd>⌘</kbd><kbd>K</kbd></span><span>Search notes and actions</span>
        <span><kbd>N</kbd></span><span>New note</span>
        <span><kbd>E</kbd></span><span>Edit the note you're reading</span>
        <span><kbd>⌘</kbd><kbd>S</kbd></span><span>Save while writing</span>
        <span><kbd>/</kbd></span><span>Commands, in Ask</span>
        <span><kbd>Space</kbd> <kbd>1</kbd> <kbd>2</kbd></span><span>Show, missed, got it, in Recall</span>
      </div>
    </section>

    <section class="setting">
      <div><h2>About</h2></div>
      <dl class="body about"><dt>Brain</dt><dd>{BRAIN}</dd><dt>Site</dt><dd>{process.cwd()}</dd><dt>Built with</dt><dd>Astro {astro}</dd></dl>
    </section>
  </div>
</Base>

<script>
import { $, api, toast } from "../scripts/util.js";
import { setTheme } from "../scripts/client.js";

// Chat engine
const form = $("engine-form"), pick = () => form.querySelector("input[name=engine]:checked")?.value;
const subs = () => form.querySelectorAll(".sub").forEach(el => { el.hidden = el.dataset.for !== pick() });
form.querySelectorAll("input[name=engine]").forEach(r => r.onchange = subs);
subs();
const pressed = (group, btn) => group.querySelectorAll("button").forEach(b => b.setAttribute("aria-pressed", b === btn));
$("model").onclick = e => { const b = e.target.closest("button"); if (b) pressed($("model"), b) };
const kind = () => $("provider").querySelector('[aria-pressed="true"]').dataset.kind;
const urlRow = () => { $("url").hidden = kind() !== "openai" };
$("provider").onclick = e => { const b = e.target.closest("button"); if (b) { pressed($("provider"), b); urlRow() } };
urlRow();
form.onsubmit = async e => {
  e.preventDefault();
  try {
    const engine = pick();
    if (engine === "api" && ($("url").value || $("key").value || $("apimodel").value || kind() === "claude"))
      await api("/api/llm", { kind: kind(), url: $("url").value, key: $("key").value, model: $("apimodel").value });
    await api("/api/settings", { engine, model: $("model").querySelector('[aria-pressed="true"]').dataset.model, edits: $("edits").checked });
    $("key").value = "";
    $("engine-saved").textContent = "Saved";
    setTimeout(() => { $("engine-saved").textContent = "" }, 2500);
  } catch (err) { toast(err.message, true) }
};

// Folders
$("folders").onclick = e => { const b = e.target.closest("button"); if (b) b.setAttribute("aria-pressed", b.getAttribute("aria-pressed") !== "true") };
$("save-folders").onclick = async () => {
  const chosen = [...$("folders").querySelectorAll("[data-f]")].filter(b => b.getAttribute("aria-pressed") === "true").map(b => b.dataset.f);
  if (!chosen.length) return toast("Pick at least one folder.", true);
  try {
    await api("/api/settings", { folders: chosen.length === $("folders").children.length ? "all" : chosen.join(" ") });
    $("folders-saved").textContent = "Saved";
    setTimeout(() => { $("folders-saved").textContent = "" }, 2500);
  } catch (err) { toast(err.message, true) }
};

// Theme
const theme = $("theme"), now = (() => { try { return localStorage.getItem("theme") || "system" } catch { return "system" } })();
pressed(theme, theme.querySelector(`[data-t="${now}"]`));
theme.onclick = e => { const b = e.target.closest("button"); if (b) { pressed(theme, b); setTheme(b.dataset.t) } };
</script>
