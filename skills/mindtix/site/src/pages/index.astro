---
import Base from "../layouts/Base.astro";
import { load, today } from "../lib/brain.js";
import { sessions } from "../lib/ask.js";
import { ago, rows, sum } from "../lib/ui.js";

const D = load(), a = D.about || {}, notes = D.notes;
const first = (D.name || "").split(" ")[0];
const hour = new Date().getHours();
const hello = (hour < 5 ? "Still up" : hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening") + (first ? `, ${first}` : "") + ".";
const now = new Date(), weekday = now.toLocaleDateString("en", { weekday: "long" }).toLowerCase();
const time = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;
const intro = a.Intro || (a["What I'm learning"] ? "Learning now: " + a["What I'm learning"] : "");
const cards = D.cards || [], due = cards.filter(c => c.due <= today()).length;
const next = cards.map(c => c.due).filter(d => d > today()).sort()[0];
const learning = notes.filter(n => n.folder === "learning" && n.id !== "learning/mistakes").sort((x, y) => y.mod - x.mod)[0];
const chat = sessions()[0];
const projects = notes.filter(n => n.folder === "projects").sort((x, y) => y.mod - x.mod).slice(0, 4);
const recent = notes.filter(n => n.folder !== "insight" && !projects.includes(n)).sort((x, y) => y.mod - x.mod).slice(0, 6);
const fmt = d => new Date(d + "T12:00").toLocaleDateString(undefined, { weekday: "short", day: "numeric", month: "short" });
const url = id => "/n/" + id.split("/").map(encodeURIComponent).join("/");
---
<Base D={D} title="Today" active="today">
  <div class="frontmatter" aria-label="Today at a glance">---<br>
    <b>date</b>: {today()} <span>· {weekday}</span><br>
    <b>brain</b>: {notes.length} notes <span>·</span> {D.links.length} links <span>·</span> {sum(notes, "words").toLocaleString()} words{cards.length > 0 && <> <span>·</span> {due} due</>}<br>---</div>
  <h1>{hello}</h1>
  {intro && <p class="lede">{intro}</p>}

  <form class="capture" id="capture" title="Saved as a line in today's raw/notes file">
    <span class="pre" aria-hidden="true"><b>-</b> <span id="clock">{time}</span></span>
    <input id="thought" placeholder="capture a thought…" autocomplete="off" aria-label="Capture a thought">
    <kbd>↵</kbd>
  </form>
  <p class="capture-note" id="capture-note" aria-live="polite"></p>

  <div class="tiles">
    {D.cards && <a class="tile" href="/recall" style="--c:var(--c0)">
      <span class="k">recall</span>
      <span class="v">{due ? `${due} card${due > 1 ? "s" : ""} due` : "All caught up"}</span>
      <span class="s">{due ? "start a round" : next ? `next on ${fmt(next).toLowerCase()}` : "no cards yet"}</span>
    </a>}
    <a class="tile" href={chat ? "/ask/" + chat.id : "/ask"} style="--c:var(--c1)">
      <span class="k">ask</span>
      <span class="v">{chat ? chat.title : "Ask your brain"}</span>
      <span class="s">{chat ? "continue the chat" : "questions, or /mindtix commands"}</span>
    </a>
    <a class="tile" href={learning ? url(learning.id) : "/ask?draft=" + encodeURIComponent("/mindtix learn ")} style="--c:var(--c2)">
      <span class="k">learning</span>
      <span class="v">{learning ? learning.title : "Learn something"}</span>
      <span class="s">{learning ? `touched ${ago(learning.mod)}` : "start with /mindtix learn"}</span>
    </a>
  </div>

  <section class="section">
    <div class="head"><h2>Recently touched</h2><a href="/notes">all notes</a></div>
    <Fragment set:html={rows(recent, true)} />
  </section>

  {projects.length > 0 && <section class="section">
    <div class="head"><h2>Projects</h2><a href="/notes?f=projects">all projects</a></div>
    <Fragment set:html={rows(projects)} />
  </section>}

</Base>

<script>
import { $, api, toast } from "../scripts/util.js";
const form = $("capture"), input = $("thought"), note = $("capture-note");
if (location.hash === "#capture") input.focus();
// The time shown is the one the line will get
const tick = () => { const d = new Date(); $("clock").textContent = `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}` };
setInterval(tick, 15000);
form.onsubmit = async e => {
  e.preventDefault();
  const text = input.value.trim();
  if (!text) return;
  try {
    const r = await api("/api/capture", { text });
    input.value = "";
    note.replaceChildren(`saved to ${r.file} · `, Object.assign(document.createElement("a"), {
      href: "/ask?run=" + encodeURIComponent("/mindtix capture process my notes"), textContent: "file it into the brain" }));
  } catch (err) { toast(err.message, true) }
};
</script>
