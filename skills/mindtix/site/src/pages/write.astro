---
import Base from "../layouts/Base.astro";
import { load, noteUrl, readNote, writable, WriteError } from "../lib/brain.js";
import { icon } from "../lib/icons.js";

// /write: new notes in tabs, saved to notes/ unless another folder is picked (?folder=); /write?id=folder/name: edit that note
const D = load(), folders = writable();
const id = Astro.url.searchParams.get("id") || "";
let note = null;
try { note = id ? readNote(id) : null } catch (e) { if (!(e instanceof WriteError)) throw e }
if (id && !note) return Astro.redirect("/write");
const folder = Astro.url.searchParams.get("folder");
const pick = folders.includes(folder) ? folder : folders.includes("notes") ? "notes" : folders[0];
const back = note ? noteUrl(id) : "/notes";
---
<Base D={D} title={note ? "Edit · " + id : "New note"} active="write" layout="bare">
  <form class="writer" id="write" data-id={note ? id : ""} data-mod={note ? String(note.mod) : ""} data-pick={pick}>
    <div class="writebar">
      <a class="iconbtn" href={back} aria-label="Back" title="Back"><Fragment set:html={icon("back")} /></a>
      <div class="pathpick">
        <span class="path" id="path" hidden></span>
        <span class="newpath" id="newpath">
          <select class="field" id="folder" aria-label="Folder">{folders.map(f => <option selected={f === pick}>{f}</option>)}</select>
          <span>/</span>
          <input class="field" id="name" placeholder="name-from-the-title" aria-label="File name" spellcheck="false" autocomplete="off"><span class="md">.md</span>
        </span>
      </div>
      <button class="btn ghost sm" type="button" id="toggle"><Fragment set:html={icon("eye")} /><span>preview</span></button>
      <button class="btn sm" type="submit"><span id="savelabel">save</span> <kbd>⌘S</kbd></button>
    </div>
    <div class="notetabs" id="tabs" role="tablist" aria-label="Open notes"></div>
    <div class="editor-wrap">
      <textarea class="editor" id="text" aria-label="Note, in markdown" spellcheck="true" placeholder="# Title&#10;&#10;Write in markdown. Type [[ to link a note.">{note ? note.src : ""}</textarea>
      <div class="suggest" id="suggest" role="listbox" hidden></div>
    </div>
    <article class="reader preview" id="preview" hidden></article>
  </form>
</Base>

<script>
import { $, api, esc, noteUrl, toast } from "../scripts/util.js";
const form = $("write"), text = $("text"), preview = $("preview"), toggle = $("toggle"), suggest = $("suggest"), bar = $("tabs");
const editing = form.dataset.id, PICK = form.dataset.pick;
const NEW = "mindtix-draft:new";

const slug = s => s.toLowerCase().normalize("NFKD").replace(/[̀-ͯ]/g, "").replace(/[^\p{L}\p{N}/]+/gu, "-").replace(/^-+|-+$|(?<=\/)-+|-+(?=\/)/g, "");
const titleOf = (s = text.value) => (s.match(/^# (.+)$/m) || [])[1]?.trim() || "";
const grow = () => { text.style.height = "auto"; text.style.height = Math.max(text.scrollHeight, innerHeight * .66) + "px" };
const blank = () => ({ id: "", folder: PICK, name: "", text: "# ", mod: null, dirty: false });
const hasText = t => t.text.replace(/^#\s*$/, "").trim() !== "";

// Tabs: {id: "" for a new note or "folder/name" once saved, folder, name, text, mod, dirty}
let tabs = [], cur = 0;
if (editing) tabs.push({ id: editing, text: text.value, mod: +form.dataset.mod, dirty: false });
// Drafts survive a closed tab: new notes always, the edited note only onto the same version of it
try {
  if (editing) {
    const d = JSON.parse(localStorage.getItem("mindtix-draft:" + editing) || "null");
    if (d && d.text !== tabs[0].text && d.mod === tabs[0].mod) { Object.assign(tabs[0], { text: d.text, dirty: true }); toast("Restored your unsaved draft") }
  } else {
    let d = JSON.parse(localStorage.getItem(NEW) || "null");
    if (d && !Array.isArray(d)) d = [{ text: d.text }]; // the one-note draft from before tabs
    for (const t of d || []) if (t.text) tabs.push({ ...blank(), ...t, dirty: true });
    if (tabs.length) toast(`Restored ${tabs.length === 1 ? "your unsaved draft" : tabs.length + " unsaved drafts"}`);
  }
} catch {}
if (!tabs.length) tabs.push(blank());

const idOf = t => t.id || t.folder + "/" + slug(t.name.trim() || titleOf(t.text));
function stash() {
  const t = tabs[cur];
  t.text = text.value;
  if (!t.id) { t.folder = $("folder").value; t.name = $("name").value }
}
function render() {
  bar.innerHTML = tabs.map((t, i) => `<span class="notetab" role="tab" data-i="${i}" aria-selected="${i === cur}" tabindex="0">${esc(titleOf(t.text) || t.id.split("/").pop() || "untitled")}${t.dirty ? '<i aria-label="unsaved">•</i>' : ""}<button type="button" data-x="${i}" aria-label="Close">×</button></span>`).join("")
    + `<button type="button" class="iconbtn" id="add" aria-label="New note" title="New note">+</button>`;
  const n = tabs.filter(t => t.dirty).length;
  $("savelabel").textContent = n > 1 ? `save ${n}` : "save";
}
function show(i) {
  cur = i;
  const t = tabs[i];
  text.value = t.text;
  $("path").hidden = !t.id; $("newpath").hidden = !!t.id;
  if (t.id) $("path").textContent = t.id + ".md";
  else { $("folder").value = t.folder; $("name").value = t.name }
  if (!preview.hidden) toggle.click();
  render(); grow(); placeholder(); text.focus();
}
let timer;
const keep = () => { clearTimeout(timer); timer = setTimeout(() => { try {
  const fresh = tabs.filter(t => !t.id && hasText(t)).map(({ folder, name, text }) => ({ folder, name, text }));
  fresh.length ? localStorage.setItem(NEW, JSON.stringify(fresh)) : localStorage.removeItem(NEW);
  const e = editing && tabs.find(t => t.id === editing);
  if (e?.dirty) localStorage.setItem("mindtix-draft:" + editing, JSON.stringify({ text: e.text, mod: e.mod }));
  else if (editing) localStorage.removeItem("mindtix-draft:" + editing);
} catch {} }, 400) };
const placeholder = () => { if (!tabs[cur].id) $("name").placeholder = slug(titleOf()) || "name-from-the-title" };
const changed = () => { stash(); tabs[cur].dirty = true; render(); keep() };
text.addEventListener("input", () => { changed(); grow(); placeholder(); complete() });
$("name").addEventListener("input", changed);
$("folder").addEventListener("change", changed);
addEventListener("beforeunload", e => { stash(); if (tabs.some(t => t.dirty)) e.preventDefault() });

bar.onclick = e => {
  const x = e.target.closest("[data-x]"), tab = e.target.closest("[data-i]");
  if (e.target.closest("#add")) { stash(); tabs.push(blank()); show(tabs.length - 1); text.setSelectionRange(2, 2); return }
  if (x) {
    stash();
    const i = +x.dataset.x, t = tabs[i];
    if (t.dirty && hasText(t) && !confirm(`Close "${titleOf(t.text) || "untitled"}" without saving?`)) return;
    tabs.splice(i, 1);
    if (!tabs.length) tabs.push(blank());
    keep(); show(Math.min(i <= cur ? Math.max(cur - 1, 0) : cur, tabs.length - 1));
  } else if (tab) { stash(); show(+tab.dataset.i) }
};
bar.onkeydown = e => { const tab = e.target.closest("[data-i]"); if (tab && e.key === "Enter") { stash(); show(+tab.dataset.i) } };
show(0);
if (!editing && tabs[0].text === "# ") text.setSelectionRange(2, 2);

// Preview, rendered by the server so [[links]] resolve the same way as on note pages
toggle.onclick = async () => {
  const showing = !preview.hidden;
  if (!showing) preview.innerHTML = (await api("/api/preview", { md: text.value }).catch(e => ({ html: `<p class="error">${esc(e.message)}</p>` }))).html;
  preview.hidden = showing; text.closest(".editor-wrap").hidden = !showing;
  toggle.querySelector("span").textContent = showing ? "preview" : "edit";
  if (showing) text.focus();
};

// Save every changed tab, one by one; stop at the first that fails and show it
form.onsubmit = async e => {
  e.preventDefault();
  stash();
  const todo = tabs.filter(t => t.dirty && (t.id || hasText(t)));
  if (!todo.length) return toast("Nothing to save.");
  let saved = 0;
  for (const t of todo) {
    const id = idOf(t);
    if (id.endsWith("/")) { show(tabs.indexOf(t)); return toast("Give the note a title first.", true) }
    try {
      const r = await api("/api/notes", { id, md: t.text, mod: t.id ? t.mod : null });
      Object.assign(t, { id: r.id, mod: r.mod, dirty: false });
      saved++;
    } catch (err) { show(tabs.indexOf(t)); keep(); return toast(`${id}: ${err.message}`, true) }
  }
  try { localStorage.removeItem(NEW); if (editing) localStorage.removeItem("mindtix-draft:" + editing) } catch {}
  keep();
  if (tabs.length === 1) return (location.href = noteUrl(tabs[0].id));
  show(cur);
  toast(`Saved ${saved} note${saved === 1 ? "" : "s"}`);
};
addEventListener("keydown", e => {
  if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "s") { e.preventDefault(); form.requestSubmit() }
});

// [[ autocomplete: suggests notes while typing a link, placed at the caret
let notes = null, hits = [], sel = 0;
function caret() {
  const m = document.createElement("div"), cs = getComputedStyle(text);
  for (const k of ["font", "lineHeight", "letterSpacing", "padding", "border", "tabSize", "width"]) m.style[k] = cs[k];
  Object.assign(m.style, { position: "absolute", visibility: "hidden", whiteSpace: "pre-wrap", overflowWrap: "break-word", top: "0", left: "0" });
  m.textContent = text.value.slice(0, text.selectionStart);
  const mark = m.appendChild(document.createElement("span"));
  mark.textContent = "​";
  text.parentElement.append(m);
  const at = { top: mark.offsetTop + parseFloat(cs.lineHeight), left: Math.min(mark.offsetLeft, text.clientWidth - 320) };
  m.remove();
  return at;
}
async function complete() {
  const q = /\[\[([^\]\n|]*)$/.exec(text.value.slice(0, text.selectionStart))?.[1];
  if (q === undefined) return (suggest.hidden = true);
  notes ||= await fetch("/search.json").then(r => r.json()).catch(() => []);
  const w = q.toLowerCase();
  hits = notes.filter(n => n.id.toLowerCase().includes(w) || n.title.toLowerCase().includes(w)).slice(0, 8);
  if (!hits.length) return (suggest.hidden = true);
  sel = 0;
  suggest.innerHTML = hits.map((n, i) => `<div role="option" data-i="${i}" aria-selected="${i === 0}">${esc(n.title)}<small>${esc(n.id)}</small></div>`).join("");
  Object.assign(suggest.style, Object.fromEntries(Object.entries(caret()).map(([k, v]) => [k, v + "px"])));
  suggest.hidden = false;
}
function pick(i) {
  const end = text.selectionStart, start = text.value.lastIndexOf("[[", end) + 2;
  const after = text.value.slice(end).startsWith("]]") ? "" : "]]";
  text.setRangeText(hits[i].id + after, start, end, "end");
  suggest.hidden = true;
  text.dispatchEvent(new Event("input"));
  text.focus();
}
text.addEventListener("keydown", e => {
  if (suggest.hidden) return;
  if (e.key === "ArrowDown" || e.key === "ArrowUp") {
    e.preventDefault();
    sel = (sel + (e.key === "ArrowDown" ? 1 : -1) + hits.length) % hits.length;
    suggest.querySelectorAll("[data-i]").forEach(el => el.setAttribute("aria-selected", +el.dataset.i === sel));
  } else if (e.key === "Enter" || e.key === "Tab") { e.preventDefault(); pick(sel) }
  else if (e.key === "Escape") suggest.hidden = true;
});
suggest.onmousedown = e => { const el = e.target.closest("[data-i]"); if (el) { e.preventDefault(); pick(+el.dataset.i) } };
text.addEventListener("blur", () => setTimeout(() => { suggest.hidden = true }, 100));
</script>
